# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required: Llama-2 weights are gated on HuggingFace. You must:
#   1. Request access at https://huggingface.co/meta-llama/Llama-2-13b-hf (approval usually fast, not instant)
#   2. Create a token at https://huggingface.co/settings/tokens (read access is enough)
#   3. Paste it below
HF_TOKEN=your_huggingface_token_here

# Same token needs to be set in the Kaggle notebook too — use Kaggle's "Secrets" feature
# (Add-ons > Secrets in the notebook editor) rather than pasting it in a cell. Never put
# a real token in a notebook cell or in any file that gets committed to git.
